syntax = "v1"

info (
	author: "Your Name"
	email:  "1283314030@example.com"
)

// ========== 统一响应 ==========
type Request {
	Code    int32       `json:"code"`     // 状态码
	Message string      `json:"message"`  // 消息
	Data    interface{} `json:"data"`
}

// ========== 管理员认证 ==========

type AdminLoginRequest {
	Username string `json:"username"`
	Password string `json:"password"`
}

type AdminLogoutRequest {
	AdminId int32 `json:"admin_id"`
}

type GetCurrentAdminRequest {
	AdminId int32 `json:"admin_id"`
}

// ========== 管理员管理 ==========

type GetAdminListRequest {
	Page     int32  `json:"page,optional"`
	PageSize int32  `json:"page_size,optional"`
	Keyword  string `json:"keyword,optional"`
}

type AdminListItem {
	Id             int32  `json:"id"`
	Username       string `json:"username"`
	RoleId         int32  `json:"role_id"`
	RoleName       string `json:"role_name"`
	Status         int32  `json:"status"`
	LastLoginTime  string `json:"last_login_time"`
}

type GetAdminDetailRequest {
	AdminId int32 `json:"admin_id"`
}

type CreateAdminRequest {
	Username string `json:"username"`
	Password string `json:"password"`
	RoleId   int32  `json:"role_id"`
}

type UpdateAdminRequest {
	AdminId  int32  `json:"admin_id"`
	Username string `json:"username"`
	RoleId   int32  `json:"role_id"`
	Status   int32  `json:"status"`
}

type DeleteAdminRequest {
	AdminId int32 `json:"admin_id"`
}

type ChangePasswordRequest {
	AdminId      int32  `json:"admin_id"`
	OldPassword  string `json:"old_password"`
	NewPassword  string `json:"new_password"`
}

// ========== 角色管理 ==========

type GetRoleListRequest {
	Page     int32  `json:"page,optional"`
	PageSize int32  `json:"page_size,optional"`
	Keyword  string `json:"keyword,optional"`
}

type RoleListItem {
	Id      int32  `json:"id"`
	Name    string `json:"name"`
	Remark  string `json:"remark"`
	MenuIds int32  `json:"menu_ids"`
}

type GetRoleDetailRequest {
	RoleId int32 `json:"role_id"`
}

type CreateRoleRequest {
	Name    string `json:"name"`
	Remark  string `json:"remark,optional"`
	MenuIds []int32 `json:"menu_ids"`
}

type UpdateRoleRequest {
	RoleId  int32  `json:"role_id"`
	Name    string `json:"name"`
	Remark  string `json:"remark,optional"`
	MenuIds []int32 `json:"menu_ids"`
}

type DeleteRoleRequest {
	RoleId int32 `json:"role_id"`
}

// ========== 菜单管理 ==========

type GetMenuListRequest {}

type MenuListItem {
	Id       int32          `json:"id"`
	ParentId int32          `json:"parent_id"`
	Name     string         `json:"name"`
	Path     string         `json:"path"`
	Icon     string         `json:"icon,optional"`
	Sort     int32          `json:"sort"`
	Children []MenuListItem `json:"children,omitempty"`
}

type GetMenuDetailRequest {
	MenuId int32 `json:"menu_id"`
}

type CreateMenuRequest {
	ParentId int32  `json:"parent_id"`
	Name     string `json:"name"`
	Path     string `json:"path"`
	Icon     string `json:"icon,optional"`
	Sort     int32  `json:"sort"`
}

type UpdateMenuRequest {
	MenuId   int32  `json:"menu_id"`
	ParentId int32  `json:"parent_id"`
	Name     string `json:"name"`
	Path     string `json:"path"`
	Icon     string `json:"icon,optional"`
	Sort     int32  `json:"sort"`
}

type DeleteMenuRequest {
	MenuId int32 `json:"menu_id"`
}

// ========== 城市配置 ==========

type GetCityListRequest {
	Page     int32  `json:"page,optional"`
	PageSize int32  `json:"page_size,optional"`
	Keyword  string `json:"keyword,optional"`
}

type CityListItem {
	Id        int32  `json:"id"`
	CityCode  string `json:"city_code"`
	CityName  string `json:"city_name"`
	Status    int32  `json:"status"`
}

type CreateCityRequest {
	CityCode string `json:"city_code"`
	CityName string `json:"city_name"`
	Status   int32  `json:"status"`
}

type UpdateCityRequest {
	Id       int32  `json:"id"`
	CityCode string `json:"city_code"`
	CityName string `json:"city_name"`
	Status   int32  `json:"status"`
}

type DeleteCityRequest {
	Id int32 `json:"id"`
}

// ========== 车型配置 ==========

type GetCarTypeListRequest {
	Page     int32  `json:"page,optional"`
	PageSize int32  `json:"page_size,optional"`
}

type CarTypeListItem {
	Id          int32   `json:"id"`
	TypeName    string  `json:"type_name"`
	BasePrice   float64 `json:"base_price"`
	KmPrice     float64 `json:"km_price"`
	MinutePrice float64 `json:"minute_price"`
	Status      int32   `json:"status"`
}

type CreateCarTypeRequest {
	TypeName    string  `json:"type_name"`
	BasePrice   float64 `json:"base_price"`
	KmPrice     float64 `json:"km_price"`
	MinutePrice float64 `json:"minute_price"`
	Status      int32   `json:"status"`
}

type UpdateCarTypeRequest {
	Id          int32   `json:"id"`
	TypeName    string  `json:"type_name"`
	BasePrice   float64 `json:"base_price"`
	KmPrice     float64 `json:"km_price"`
	MinutePrice float64 `json:"minute_price"`
	Status      int32   `json:"status"`
}

type DeleteCarTypeRequest {
	Id int32 `json:"id"`
}

// ========== 订单管理（后台派单）==========

type DispatchOrderRequest {
	PassengerName  string  `json:"passenger_name"`   // 乘客姓名
	PassengerPhone string  `json:"passenger_phone"`  // 乘客电话
	StartAddress   string  `json:"start_address"`     // 出发地址
	StartLng       float64 `json:"start_lng"`        // 出发地经度
	StartLat       float64 `json:"start_lat"`        // 出发地纬度
	EndAddress     string  `json:"end_address"`       // 目的地地址
	EndLng         float64 `json:"end_lng"`           // 目的地经度
	EndLat         float64 `json:"end_lat"`           // 目的地纬度
	CarType        int32   `json:"car_type"`          // 车型：1-经济型，2-舒适型，3-商务型，4-豪华型
	DriverId       int64   `json:"driver_id"`         // 目标司机ID
	Remark         string  `json:"remark,optional"`   // 备注
	EstimatedPrice float64 `json:"estimated_price,optional"` // 预估价格
}

type GetOrderListRequest {
	Page     int32  `json:"page,optional"`
	PageSize int32  `json:"page_size,optional"`
	Keyword  string `json:"keyword,optional"`   // 关键词搜索
	Status   int32  `json:"status,optional"`     // 状态筛选
}

type SyncOrderStatusRequest {
	OrderId      string  `json:"order_id"`
	Status       int32   `json:"status"`
	DriverId     int64   `json:"driver_id,optional"`
	FinalPrice   float64 `json:"final_price,optional"`
	CancelReason string  `json:"cancel_reason,optional"`
}

type OrderListItem {
	OrderId         string  `json:"order_id"`
	PassengerName   string  `json:"passenger_name"`
	PassengerPhone  string  `json:"passenger_phone"`
	DriverName      string  `json:"driver_name"`
	DriverPhone     string  `json:"driver_phone"`
	CarType         string  `json:"car_type"`
	StartAddress    string  `json:"start_address"`
	EndAddress      string  `json:"end_address"`
	Status          int32   `json:"status"`
	EstimatedPrice  float64 `json:"estimated_price"`
	FinalPrice      float64 `json:"final_price"`
	CreatedAt       int64   `json:"created_at"`
}

// ========== 路由定义 ==========

service admin-api {
	@handler AdminLogin
	post /admin/login (AdminLoginRequest) returns (Request)

	@handler AdminLogout
	post /admin/logout (AdminLogoutRequest) returns (Request)

	@handler GetCurrentAdmin
	post /admin/current (GetCurrentAdminRequest) returns (Request)

	@handler GetAdminList
	post /admin/list (GetAdminListRequest) returns (Request)

	@handler GetAdminDetail
	post /admin/detail (GetAdminDetailRequest) returns (Request)

	@handler CreateAdmin
	post /admin/create (CreateAdminRequest) returns (Request)

	@handler UpdateAdmin
	post /admin/update (UpdateAdminRequest) returns (Request)

	@handler DeleteAdmin
	post /admin/delete (DeleteAdminRequest) returns (Request)

	@handler ChangePassword
	post /admin/change-password (ChangePasswordRequest) returns (Request)

	@handler GetRoleList
	post /role/list (GetRoleListRequest) returns (Request)

	@handler GetRoleDetail
	post /role/detail (GetRoleDetailRequest) returns (Request)

	@handler CreateRole
	post /role/create (CreateRoleRequest) returns (Request)

	@handler UpdateRole
	post /role/update (UpdateRoleRequest) returns (Request)

	@handler DeleteRole
	post /role/delete (DeleteRoleRequest) returns (Request)

	@handler GetMenuList
	post /menu/list (GetMenuListRequest) returns (Request)

	@handler GetMenuDetail
	post /menu/detail (GetMenuDetailRequest) returns (Request)

	@handler CreateMenu
	post /menu/create (CreateMenuRequest) returns (Request)

	@handler UpdateMenu
	post /menu/update (UpdateMenuRequest) returns (Request)

	@handler DeleteMenu
	post /menu/delete (DeleteMenuRequest) returns (Request)

	@handler GetCityList
	post /city/list (GetCityListRequest) returns (Request)

	@handler CreateCity
	post /city/create (CreateCityRequest) returns (Request)

	@handler UpdateCity
	post /city/update (UpdateCityRequest) returns (Request)

	@handler DeleteCity
	post /city/delete (DeleteCityRequest) returns (Request)

	@handler GetCarTypeList
	post /cartype/list (GetCarTypeListRequest) returns (Request)

	@handler CreateCarType
	post /cartype/create (CreateCarTypeRequest) returns (Request)

	@handler UpdateCarType
	post /cartype/update (UpdateCarTypeRequest) returns (Request)

	@handler DeleteCarType
	post /cartype/delete (DeleteCarTypeRequest) returns (Request)

	@handler DispatchOrder
	post /order/dispatch (DispatchOrderRequest) returns (Request)

	@handler GetOrderList
	post /order/list (GetOrderListRequest) returns (Request)

	@handler SyncOrderStatus
	post /order/status/sync (SyncOrderStatusRequest) returns (Request)
}
